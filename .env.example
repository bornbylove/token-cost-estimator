# Copy to .env to override defaults. All variables are optional.

# Browser origins allowed to call the API (JSON list).
TOKENCOST_CORS_ORIGINS=["http://localhost:5173"]

# Path to the pricing file. Defaults to the one bundled in src/tokencost/data/.
# TOKENCOST_PRICING_FILE=/path/to/pricing.yaml

# Days after a price's effective_date before estimates are flagged as stale.
TOKENCOST_STALE_AFTER_DAYS=90
